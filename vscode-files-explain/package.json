{
  "name": "vscode-files-explain",
  "displayName": "文件解读 Files Explain",
  "description": "侧边栏文件树 + 逐函数 AI 中文解读与 mermaid 调用图（dsh-files 的 VS Code 移植版）",
  "version": "0.0.1",
  "publisher": "dsh-plugins",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "explain",
    "ai",
    "code",
    "中文解读",
    "call-graph"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.svg",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshFiles",
          "title": "文件解读",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dshFiles": [
        {
          "type": "webview",
          "id": "dshFiles.view",
          "name": "文件解读",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "文件解读 (Files Explain)",
      "properties": {
        "dsh-files-explain.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API Key；留空则尝试使用 GitHub Copilot（vscode.lm，需安装并登录 Copilot）。"
        },
        "dsh-files-explain.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "DeepSeek 模型名（deepseek-chat / deepseek-reasoner）。"
        },
        "dsh-files-explain.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "OpenAI 兼容 API 端点（默认 DeepSeek 官方）。"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node scripts/smoke.cjs",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "mermaid": "^11.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
